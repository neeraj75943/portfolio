# Frontend: leave blank locally to use Vite's /api proxy. Set this only when the
# API is deployed on a different origin (for example, https://api.example.com).
VITE_API_URL=

# Backend
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Comma-separated browser origins permitted to call the API in production.
CLIENT_ORIGIN=http://localhost:5173

# Optional SMTP notification. Leave these blank to save contact messages to
# MongoDB without sending an email notification.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password-or-app-password
MAIL_FROM=Portfolio Contact <no-reply@example.com>
NOTIFICATION_EMAIL=your-email@example.com
